# Copy to .env and change the secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,adredirector.loc
# Local only: host port for the web container, e.g. http://adredirector.loc:8000
# (add "127.0.0.1 adredirector.loc" to your hosts file).
WEB_PORT=8000
# Needed for admin login when served on a real domain, e.g. https://links.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=ad_redirector
POSTGRES_USER=ad_redirector
POSTGRES_PASSWORD=change-me

# pgAdmin login (http://localhost:5050).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Admin account created on first start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Set to 1 only behind one reverse proxy that sets X-Forwarded-For (docker-compose.prod.yml does this).
USE_X_FORWARDED_FOR=0

# Optional: override where links redirect ({code} = the JuicyAds code ID).
# JUICYADS_REDIRECT_URL=http://xapi.juicyads.com/<your-hash>.php?juicy_code={code}&u=http%3A%2F%2Fwww.juicyads.rocks

# MaxMind databases, downloaded daily by Celery (maxmind.com → Account → Manage License Keys).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Add GeoIP2-Anonymous-IP (paid) to also block VPNs and proxies.
# MAXMIND_EDITION_IDS=GeoLite2-Country,GeoLite2-ASN

# Traffic filtering on /go/<code>/.
# 1 = only record what would be blocked (Click "blocked reason" in the admin), block nothing.
TRAFFIC_FILTER_LOG_ONLY=0
# Where blocked visitors are sent.
TRAFFIC_FILTER_BLOCKED_URL=/
# ISO country codes, comma-separated. Empty allowed list = every country allowed.
TRAFFIC_FILTER_ALLOWED_COUNTRIES=
TRAFFIC_FILTER_BLOCKED_COUNTRIES=
# Extra ASNs to block on top of the built-in cloud/hosting list, e.g. 12345,67890.
TRAFFIC_FILTER_EXTRA_BLOCKED_ASNS=
# Block repeat visits from the same IP to the same link within this many hours (0 = off).
TRAFFIC_FILTER_REPEAT_CLICK_HOURS=24
# JavaScript check page before redirecting (0 = off).
TRAFFIC_FILTER_CHALLENGE=1

# Data retention (GDPR), applied daily. 0 = keep forever.
# Days before full visitor IPs are cleared (a hash is kept for the repeat-click check).
CLICK_IP_RETENTION_DAYS=7
# Days before blocked and successful clicks are deleted. Link visit counts are not affected.
BLOCKED_CLICK_RETENTION_DAYS=30
CLICK_RETENTION_DAYS=365

# Shown on the privacy page (/privacy/): who runs the site and how to reach them.
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# Celery broker (the compose file points this at the redis service).
CELERY_BROKER_URL=redis://redis:6379/0

# Production only (docker-compose.prod.yml): public domain and Let's Encrypt contact email.
# Also set DJANGO_ALLOWED_HOSTS=<domain> and DJANGO_CSRF_TRUSTED_ORIGINS=https://<domain>.
DOMAIN=
LETSENCRYPT_EMAIL=
